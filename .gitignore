# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo

# Per-user editor / agent config (keep shared parts; ignore local overrides)
.claude/settings.local.json
.vscode/*.local.json

# =============================================================================
# Verilator build output
# Regenerated by `make verilate` or `v0/build_sim.ps1`. Everything in obj_dir/
# is derived from rtl/ and sim/cpp/sim_main.cpp.
# =============================================================================
v0/obj_dir/

# =============================================================================
# Trained models / generated weights / generated artifacts
# All regenerable by re-running train.py. Comment a line out if you'd rather
# version a particular artifact (e.g. a "golden" model).
# =============================================================================
# models/
# memory/
plots/
data/

# =============================================================================
# Vivado block-design generated output
#
# Keep:
#   transformer_block_design.bd      <- the design source-of-truth (JSON)
#   transformer_block_design_ooc.xdc <- if you hand-edited constraints
#
# Ignore everything else under transformer_block_design/ -- Vivado regenerates
# it from the .bd file via `generate_target all` on first project open.
# =============================================================================
Vivado/transformer_block_design/hdl/
Vivado/transformer_block_design/hw_handoff/
Vivado/transformer_block_design/ip/
Vivado/transformer_block_design/ipshared/
Vivado/transformer_block_design/sim/
Vivado/transformer_block_design/synth/
Vivado/transformer_block_design/ui/
Vivado/transformer_block_design/*.bda
Vivado/transformer_block_design/*.bxml
Vivado/transformer_block_design/*.veo
Vivado/transformer_block_design/*.vho
Vivado/transformer_block_design/*.sv
Vivado/transformer_block_design/*.sveo

# =============================================================================
# Vivado *project* output (mqp_real lives outside this repo, but if anyone
# ever creates a Vivado project inside, these are 100% derived)
# =============================================================================
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.tmp/
*.gen/
*.jou
*.log
*.str
*.pb
*.dcp
*.bit
*.ltx
*.wdf
*.wcfg
*.wdb
*.vds
.Xil/

